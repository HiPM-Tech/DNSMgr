# =============================================================================
# HiDNS 环境配置
# 文件位置: data/.env（自动加载，优先级最高）或 .env（项目根目录）
# =============================================================================

# ── 数据库类型 ──────────────────────────────────────────────────────────────
# 可选: sqlite, mysql, postgresql
DB_TYPE=sqlite

# ◆ SQLite（默认）
DB_PATH=./data/hidns.db
DB_SQLITE_WAL=true
DB_SQLITE_FOREIGN_KEYS=true

# ◆ MySQL（取消注释启用）
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=hidns
# DB_USER=root
# DB_PASSWORD=your_password
# DB_SSL=false
# DB_CONNECTION_LIMIT=10

# ◆ PostgreSQL（取消注释启用）
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=hidns
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_SSL=false
# DB_POOL_SIZE=10

# ── 数据库调试 ──────────────────────────────────────────────────────────────
DB_LOGGING=false                    # SQL 日志（生产建议关闭）
DB_SLOW_QUERY_THRESHOLD=100        # 慢查询阈值(ms)

# ── JWT / Token ────────────────────────────────────────────────────────────
# 生产环境必填！建议 64 位以上随机字符串
# 不设置时每次重启随机生成（开发可用，生产会导致已签发的 Token 失效）
JWT_SECRET=

# ── Cookie ─────────────────────────────────────────────────────────────────
# 控制 Cookie 的 secure 标志
#   true  → 强制 HTTPS（生产安全推荐）
#   false → 允许 HTTP（CI/内网测试）
#   不设  → 自动检测请求协议（HTTPS→true, HTTP→false）
COOKIE_SECURE=

# ── 反向代理信任 ────────────────────────────────────────────────────────────
# 生产环境建议开启，确保 req.protocol / req.ip 在 Nginx 反代后正确取值
#   loopback  → 信任本地回环代理（默认生产值）
#   1         → 信任最近 1 跳代理
#   10.0.0.0/8 → 信任指定网段
#   不设      → 生产自动用 loopback，开发不开启
TRUST_PROXY=

# ── 服务端口 ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development                # production | development | test

# ── CORS ────────────────────────────────────────────────────────────────────
# 允许的跨域来源（逗号分隔），不设则允许所有来源（开发模式）
# 生产建议设为具体域名，如 https://hidns.example.com
CORS_ORIGIN=

# ── API 文档基础 URL ───────────────────────────────────────────────────────
# Swagger 文档中显示的服务器地址，不设则使用 localhost:PORT
API_BASE_URL=

# ── WebAuthn（FIDO2 无密码认证） ──────────────────────────────────────────
# WEBAUTHN_RP_ID=hidns.example.com
# WEBAUTHN_ORIGIN=https://hidns.example.com

# ── SMTP（邮件发送） ──────────────────────────────────────────────────────
# SMTP_TIMEOUT_MS=15000